execution-verb-name = Execute
execution-verb-message = Use your weapon to execute someone.

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# weapon (the weapon used for the execution)

execution-popup-melee-initial-internal = You ready {THE($weapon)} against {$victim}'s throat.
execution-popup-melee-initial-external = {$attacker} readies {POSS-ADJ($attacker)} {$weapon} against the throat of {$victim}.
execution-popup-melee-complete-internal = You slit the throat of {$victim}!
execution-popup-melee-complete-external = {$attacker} slits the throat of {$victim}!

execution-popup-self-initial-internal = You ready {THE($weapon)} against your own throat.
execution-popup-self-initial-external = {$attacker} readies {POSS-ADJ($attacker)} {$weapon} against their own throat.
execution-popup-self-complete-internal = You slit your own throat!
execution-popup-self-complete-external = {$attacker} slits their own throat!

# ERRORGATE: executing with a gun
execution-popup-gun-initial-internal = You press {THE($weapon)} against the head of {$victim}.
execution-popup-gun-initial-external = {$attacker} presses {POSS-ADJ($attacker)} {$weapon} against the head of {$victim}.
execution-popup-gun-complete-internal = You pull the trigger.
execution-popup-gun-complete-external = {$attacker} shoots {$victim} point blank!
execution-popup-gun-empty = The {$weapon} clicks. There is nothing to fire.
execution-popup-gun-self-initial-internal = You put {THE($weapon)} to your own head.
execution-popup-gun-self-initial-external = {$attacker} puts {POSS-ADJ($attacker)} {$weapon} to {POSS-ADJ($attacker)} own head.
execution-popup-gun-self-complete-internal = You pull the trigger.
execution-popup-gun-self-complete-external = {$attacker} pulls the trigger with the gun at {POSS-ADJ($attacker)} own head!
